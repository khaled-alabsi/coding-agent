# Azure OpenAI Configuration (for cloud-based LLM)
# Copy this file to .env and fill in your actual values

# Your Azure OpenAI API Key (found in Azure Portal)
AZURE_OPENAI_API_KEY=your_api_key_here

# Your Azure OpenAI Endpoint URL (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Your Azure OpenAI Deployment Name (the name you gave your model deployment)
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional: API Version (default is 2024-02-15-preview)
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ===================================================================
# Local LLM Configuration (for LM Studio)
# ===================================================================

# Local LLM API Base URL (LM Studio default)
LOCAL_LLM_API_BASE=http://localhost:1234/v1

# Local Model Name (as shown in LM Studio)
# Example: deepseek/deepseek-r1-0528-qwen3-8b
LOCAL_LLM_MODEL=deepseek/deepseek-r1-0528-qwen3-8b
